# Example environment file for PRODUCTION. Copy any real values you need
# into C:\devops-demo\production\current.env -- that file is generated
# automatically by scripts/deploy.ps1 and is NOT committed to git.
APP_ENV=production
PORT=5000
DB_PATH=C:\devops-demo\production\data\incidents.db
# Safe placeholder; scripts/deploy.ps1 overrides this from a Jenkins
# "secret text" credential named ALERT_WEBHOOK_URL when one is configured.
ALERT_WEBHOOK_URL=http://localhost:9099/webhook
