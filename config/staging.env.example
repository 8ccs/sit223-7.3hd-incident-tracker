# Example environment file for STAGING. Copy any real values you need into
# C:\devops-demo\staging\current.env -- that file is generated automatically
# by scripts/deploy.ps1 and is NOT committed to git (see .gitignore).
APP_ENV=staging
PORT=5001
DB_PATH=C:\devops-demo\staging\data\incidents.db
# Safe placeholder; scripts/deploy.ps1 overrides this from a Jenkins
# "secret text" credential named ALERT_WEBHOOK_URL when one is configured.
ALERT_WEBHOOK_URL=http://localhost:9099/webhook
